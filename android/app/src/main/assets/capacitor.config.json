{
	"appId": "mg.madacommerce.app",
	"appName": "Mada Commerce",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"*.firebaseapp.com",
			"*.googleapis.com",
			"*.google.com"
		]
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	}
}
